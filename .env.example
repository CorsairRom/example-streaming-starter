# --- Application ---------------------------------------------------------
APP_NAME="c-Conecta Streaming Starter"
APP_VERSION="v0.1.0"
ENV="local"
DEBUG=false
HOST="127.0.0.1"
PORT=8000

# --- Database ------------------------------------------------------------
# SQLite by default: zero setup. The file is created on first start.
DATABASE_URL="sqlite+pysqlite:///./data/app.db"

# --- Admin panel ---------------------------------------------------------
# Change these before exposing the service to the internet.
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="change-me-please"
SESSION_SECRET="change-me-too-this-signs-the-admin-cookie"
SESSION_HTTPS_ONLY=false
